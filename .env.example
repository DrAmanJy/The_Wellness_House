APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://wellness:local-development-only@127.0.0.1:55432/wellness
DB_POOL_SIZE=10
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NOTES_ENCRYPTION_KEY=
NOTES_KEY_VERSION=v1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Signed Apple client-secret JWT. Rotate before its expiry.
APPLE_CLIENT_SECRET=
MAIL_API_KEY=
MAIL_FROM=
STAFF_NOTIFICATION_EMAIL=
MEDIA_DIRECTORY=work/private-media
# Only enable behind a proxy that replaces incoming X-Forwarded-For.
TRUST_PROXY=false

# Enable only for isolated local staff testing; production always rejects these routes.
ALLOW_DEV_ADMIN_AUTH=false
# Razorpay hosted checkout. Commerce also needs approved database settings, prices and stock.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
