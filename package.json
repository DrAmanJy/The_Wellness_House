{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env.local server/http.ts",
    "build": "next build",
    "start": "tsx --env-file-if-exists=.env.local scripts/start.ts",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types lib/rituals.test.ts",
    "clean": "next clean",
    "db:migrate": "tsx --env-file-if-exists=.env.local server/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local server/db/seed.ts",
    "owner:bootstrap": "tsx --env-file-if-exists=.env.local server/modules/identity/bootstrap.ts",
    "worker": "tsx --env-file-if-exists=.env.local worker/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test:backend": "tsx --env-file-if-exists=.env.local scripts/test-backend.ts",
    "db:local": "tsx scripts/local-db.ts",
    "preview:production": "tsx --env-file-if-exists=.env.local scripts/preview-server.ts",
    "test:http": "tsx scripts/http-smoke.ts",
    "test:http:boundaries": "tsx --env-file-if-exists=.env.local scripts/http-boundaries.ts",
    "test:http:customer": "tsx --env-file-if-exists=.env.local scripts/http-customer.ts",
    "test:http:razorpay": "tsx --env-file-if-exists=.env.local scripts/http-razorpay.ts",
    "test:http:security": "tsx scripts/http-security.ts"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^5.2.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "postcss": "^8.5.23",
    "razorpay": "^2.9.8",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.1",
    "eslint-config-next": "^15.5.28",
    "prettier": "^3.9.10",
    "tailwindcss": "4.1.11",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "type": "module"
}
